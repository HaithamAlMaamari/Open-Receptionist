# Open Receptionist — environment configuration
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# ── Provider selection (swap vendors without touching code) ─────────────
STT_PROVIDER=deepgram        # available: deepgram
LLM_PROVIDER=anthropic       # available: anthropic
TTS_PROVIDER=elevenlabs      # available: elevenlabs

# ── Deepgram (STT) ───────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3-general
# Default is "multi" (Arabic/English code-switching). Set "ar" to force
# single-language Arabic if code-switching mode underperforms your dialect.
# DEEPGRAM_LANGUAGE=multi

# ── Anthropic (LLM) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-5
# LLM_MAX_TOKENS=1024

# ── ElevenLabs (TTS) ─────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
# Pick a voice that supports Arabic + English (multilingual model is default).
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Business config ──────────────────────────────────────────────────────
# Defaults to config/business.yaml, falling back to config/business.example.yaml
# BUSINESS_CONFIG=config/business.yaml

# ── Transcripts (compliance default: always logged) ─────────────────────
# When set, call transcripts are written as JSONL files to this directory
# (gitignored). Milestone 2 replaces this with Postgres.
TRANSCRIPT_DIR=logs/transcripts
# Set to 1 to also echo transcript lines to stdout while debugging locally.
# Off by default so caller PII stays out of container logs / log shippers.
# TRANSCRIPT_ECHO=1

# ── Testing ──────────────────────────────────────────────────────────────
# Unit tests need NO keys and no pipecat install. On a machine with
# pipecat-ai installed, set RUN_PIPECAT_INTEGRATION=1 to also smoke-test the
# real pipecat import surface (runs in CI too).
# RUN_PIPECAT_INTEGRATION=1
